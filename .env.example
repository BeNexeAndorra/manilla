# Còpia'l a .env i canvia el secret abans de treure res de local.
DATABASE_URL=postgres://manilla:manilla@localhost:5432/manilla
PORT=8080
# Carpeta amb el front-end compilat (`npm --prefix web run build`).
STATIC_DIR=web/dist
# Posa-ho a 1 quan serveixis per HTTPS: marca la galeta de sessió com a Secure.
COOKIE_SECURE=0

# ── Entrada amb Google (opcional) ──────────────────────────────────────────
# Sense aquestes dues, el botó de Google no apareix i només hi ha registre
# manual. Per obtenir-les: console.cloud.google.com → APIs i serveis →
# Credencials → ID de client d'OAuth 2.0 → Aplicació web, i hi afegeixes
# aquest URI de redirecció autoritzat:
#   http://localhost:8080/api/auth/google/retorn
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# L'origen públic del servidor, per construir l'URI de retorn.
ORIGEN=http://localhost:8080
